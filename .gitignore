# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android local config / signing material
/android/local.properties
/android/.gradle/
/android/key.properties
*.jks
*.keystore

# iOS / macOS build & dependency artifacts
/ios/Pods/
/ios/.symlinks/
/ios/Flutter/Flutter.framework
/ios/Flutter/Flutter.podspec
**/Podfile.lock

# 古兰经离线识别资产（约 99 MB，不入版本库）
# 获取方式：bash tools/quran_offline/download_assets.sh
/assets/quran_offline/*
!/assets/quran_offline/.gitkeep
# 例外：词表只有 21 KB，是两端共用的 ASR 侧资源，且广播侧的单元测试
# （BroadcastQuranLibrary.load → QuranAssets.loadVocabularyOnly）需要它。
# 不入库会让干净 clone 下的 flutter test 依赖 103 MB 模型下载，故随仓库分发。
!/assets/quran_offline/vocab.json

# Python 验证脚本的虚拟环境与缓存（.venv、.venv122 等）
**/.venv*/
__pycache__/
*.pyo

# 古兰经离线识别：大体积模型资产（用 tools/quran_offline/download_assets.sh 获取）
assets/quran_offline/*.onnx
assets/quran_offline/quran_ctc_tokens.json

# 本地 Python 验证环境与样本
tools/quran_offline/.venv/
tools/quran_offline/.venv122/
tools/quran_offline/samples/

# Tilawa 对比工程的依赖（Node）
tools/tilawa_compare/node_modules/

# 广播语料音频候选：用户确认可入库（2 份王权章整章 MP3，约 15 MB）。
# 来源、字节数、SHA256 与校验状态见 resources/broadcast_quran/manifest.json；
# 测试音频不随 App 安装包分发（未列入 pubspec assets）。

# 全经诵读音频（Alafasy 114 章，约 880 MB）：体积过大，不入版本库。
# 来源模板、已完成章节与校验信息记录在 resources/broadcast_quran/manifest.json，
# 需要时按该清单重新获取。
resources/broadcast_quran/full_recitation/
