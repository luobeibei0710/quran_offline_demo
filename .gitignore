# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# 编辑器工作区文件（不同项目的工程组合不应入库）
*.code-workspace

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android local config / signing material
/android/local.properties
/android/.gradle/
/android/key.properties
*.jks
*.keystore

# iOS / macOS build & dependency artifacts
/ios/Pods/
/ios/.symlinks/
/ios/Flutter/Flutter.framework
/ios/Flutter/Flutter.podspec
**/Podfile.lock

# 古兰经离线识别资产（约 99 MB，不入版本库）
# 获取方式：bash tools/quran_offline/download_assets.sh
/assets/quran_offline/*
!/assets/quran_offline/.gitkeep

# Python 验证脚本的虚拟环境与缓存（.venv、.venv122 等）
**/.venv*/
__pycache__/
*.pyo

# 古兰经离线识别：大体积模型资产（用 tools/quran_offline/download_assets.sh 获取）
assets/quran_offline/*.onnx
assets/quran_offline/quran_ctc_tokens.json

# 本地 Python 验证环境与样本
tools/quran_offline/.venv/
tools/quran_offline/.venv122/
tools/quran_offline/samples/

# Tilawa 对比工程的依赖（Node）
tools/tilawa_compare/node_modules/

# 广播语料音频候选：再分发权利未核实（manifest 中 redistributionRights=pending），
# 且单文件数 MB 级，不入版本库。来源、字节数与 SHA256 记录在
# resources/broadcast_quran/manifest.json，需要时按该记录重新获取并校验。
resources/broadcast_quran/audio_candidates/
